OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=90

# Bind of the main API in docker-compose.yml. Leave at 127.0.0.1 (default) unless you have
# put authentication/access control in front of it: /api/scrape/* has no auth.
OBSERVATOIRE_HOST=127.0.0.1

# Crawler politeness (scrapers.py): minimum delay between two requests to the same host,
# and how many times a transient failure (timeout, 429/500/502/503/504) is retried with
# exponential backoff before being counted as an error.
CRAWL_DELAY_SECONDS=0.5
CRAWL_MAX_RETRIES=2

# Optional contact appended to the crawler's User-Agent (recommended for real deployments,
# so a site owner can reach you instead of just blocking the IP).
CRAWLER_CONTACT=

# AI fallback provider for market-fact extraction: "ollama" (default, local) or "anthropic".
# Never put a real key in this file (.env.example is committed) -- set ANTHROPIC_API_KEY in
# your own .env instead, which is already gitignored.
AI_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5
# Modele de l'agent d'analyse (analyst.py). Charge opposee a l'extraction : une passe par
# lot de decisions, sur une petite entree, la ou la qualite de raisonnement compte le plus
# pour le cout le plus faible. Ne pas partager le reglage de l'extraction.
ANTHROPIC_ANALYST_MODEL=claude-opus-5

# OpenAlex requires an api_key on every request since February 2026 (usage-based pricing, a
# modest free daily budget per key -- see openalex.py's _mailto_params). Free to obtain at
# openalex.org. Never put a real key in this file -- set it in your own .env instead.
OPENALEX_API_KEY=

# EPO Open Patent Services (patent.py) : free developer account at developers.epo.org.
# Never put real values in this file -- set them in your own .env instead.
EPO_OPS_KEY=
EPO_OPS_SECRET=

# Lens.org Patent API (lens.py) : free token on lens.org/lens/user (API & Data tab, once your
# access request is approved -- academic/non-commercial use). Never put a real value here.
LENS_API_KEY=

# Google Patents Public Datasets on BigQuery (google_patents.py) : needs a GCP project with
# billing enabled (1 TB/month of query processing is free, well above what this connector
# reads) and a service account with the "BigQuery User" role. GOOGLE_APPLICATION_CREDENTIALS
# is the path to that service account's JSON key -- never commit the key itself, and never put
# real values here. Requires `pip install -r requirements-google-patents.txt` (kept out of
# requirements.txt on purpose, see google_patents.py).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
# Optional: caps bytes BILLED per query (not bytes read), default 5 GB (google_patents.py).
GOOGLE_PATENTS_MAX_BYTES_BILLED=
