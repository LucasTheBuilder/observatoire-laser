OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=90

# Bind of the main API in docker-compose.yml. Leave at 127.0.0.1 (default) unless you have
# put authentication/access control in front of it: /api/scrape/* has no auth.
OBSERVATOIRE_HOST=127.0.0.1

# Crawler politeness (scrapers.py): minimum delay between two requests to the same host,
# and how many times a transient failure (timeout, 429/500/502/503/504) is retried with
# exponential backoff before being counted as an error.
CRAWL_DELAY_SECONDS=0.5
CRAWL_MAX_RETRIES=2

# Optional contact appended to the crawler's User-Agent (recommended for real deployments,
# so a site owner can reach you instead of just blocking the IP).
CRAWLER_CONTACT=

# AI fallback provider for market-fact extraction: "ollama" (default, local) or "anthropic".
# Never put a real key in this file (.env.example is committed) -- set ANTHROPIC_API_KEY in
# your own .env instead, which is already gitignored.
AI_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5
