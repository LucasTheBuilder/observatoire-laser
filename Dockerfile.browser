FROM mcr.microsoft.com/playwright/python:v1.57.0-noble

WORKDIR /browser
COPY requirements-browser.txt ./requirements-browser.txt
RUN pip install --no-cache-dir -r requirements-browser.txt
COPY browser_service.py ./browser_service.py

EXPOSE 8780
CMD ["uvicorn", "browser_service:app", "--host", "0.0.0.0", "--port", "8780"]
